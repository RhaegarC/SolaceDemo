<Window x:Class="SolaceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SolaceClient"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Solace Client" Height="600" Width="820"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="RefusedRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#B00020" />
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText" Style="{StaticResource Dim}"
                   Text="Not connected." />

        <TabControl Grid.Row="1" Margin="0,8,0,0">

            <!-- Case attachments -->
            <TabItem Header="Case attachments">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Case identity -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Case" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Column="1" x:Name="CaseIdBox" Margin="8,0" Padding="4"
                                 IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" x:Name="NewCaseButton" Content="New case" Padding="12,4"
                                Click="NewCaseButton_Click" />
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="LimitsHint" Margin="0,8,0,0" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" />

                    <!-- Staged files -->
                    <ListView Grid.Row="2" x:Name="FilesList" Margin="0,10,0,0"
                              ItemsSource="{Binding Attachments}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource RefusedRow}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefused}" Value="False">
                                        <Setter Property="Foreground" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File" Width="340" DisplayMemberBinding="{Binding FileName}" />
                                <GridViewColumn Header="Format" Width="80" DisplayMemberBinding="{Binding Format}" />
                                <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Status}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddFilesButton" Content="Add files…" Padding="12,4"
                                Click="AddFilesButton_Click" />
                        <Button x:Name="PublishButton" Content="Publish case" Padding="12,4" Margin="8,0,0,0"
                                Click="PublishButton_Click" />
                        <Button x:Name="ClearButton" Content="Clear" Padding="12,4" Margin="8,0,0,0"
                                Click="ClearButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- JSON message -->
            <TabItem Header="JSON message">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Topic" FontWeight="SemiBold" />

                    <!-- Read-only: the destination comes from Demo:TestTopic in appsettings.json.
                         Typing a topic here would make the tab send somewhere the config does not
                         describe, which is the one thing a fixed test destination avoids. -->
                    <TextBox Grid.Row="1" x:Name="JsonTopicBox" Margin="0,4,0,0" Padding="4"
                             IsReadOnly="True" FontFamily="Consolas"
                             VerticalContentAlignment="Center" />

                    <TextBox Grid.Row="2" x:Name="JsonBodyBox" Margin="0,10,0,0" Padding="4"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SendJsonButton" Content="Send JSON" Padding="12,4"
                                Click="SendJsonButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Publish log -->
        <TextBox Grid.Row="2" x:Name="LogBox" Margin="0,10,0,0" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
